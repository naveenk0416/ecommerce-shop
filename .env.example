# .env.example — template only. Copy to backend/.env and fill in real values.
# Never commit real credentials to this file: it is tracked by git.
GEMINI_API_KEY='your_gemini_api_key'
RAZORPAY_KEY_ID='your_razorpay_key_id'
RAZORPAY_KEY_SECRET='your_razorpay_key_secret'
# Resend (https://resend.com) — SMTP is blocked outbound on Render, so email goes over Resend's
# HTTPS API instead. RESEND_FROM must be on a domain verified in the Resend dashboard; until then,
# only 'onboarding@resend.dev' is accepted as the sender.
RESEND_API_KEY='your_resend_api_key'
RESEND_FROM='onboarding@resend.dev'
MONGO_URI=
JWT_SECRET='your_jwt_secret_key'
PORT=3000
FRONTEND_URL='http://localhost:4200'
BACKEND_URL='http://localhost:4000'
# 32-byte key (base64) used to encrypt marketplace OAuth refresh tokens at rest. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY='your_32_byte_base64_key'

# Amazon SP-API (Login with Amazon) — from Seller Central > Develop Apps.
AMAZON_APP_ID='your_amazon_application_id'
AMAZON_LWA_CLIENT_ID='your_lwa_client_id'
AMAZON_LWA_CLIENT_SECRET='your_lwa_client_secret'
AMAZON_SELLER_CENTRAL_HOST='sellercentral.amazon.in'

# Flipkart Marketplace Seller API — from Seller APIs > Developer Admin.
FLIPKART_CLIENT_ID='your_flipkart_client_id'
FLIPKART_CLIENT_SECRET='your_flipkart_client_secret'
