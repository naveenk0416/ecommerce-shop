# Hostinger (Apache/LiteSpeed) rules for the Angular SPA.
# Real files (robots.txt, sitemap.xml, /assets/*, JS/CSS bundles) are served as-is with the right
# content type; only known app routes fall back to index.html for client-side routing. Every other
# path gets a real 404 status (the SPA still renders its "Page not found" view, so search engines
# drop the URL but visitors see the normal site).

AddType text/plain .txt
AddType application/xml .xml
AddType application/manifest+json .webmanifest

# Unknown URLs: serve the SPA shell *with* status 404. The browser keeps the requested URL, so the
# app's "**" route shows "Page not found" (and adds noindex).
ErrorDocument 404 /index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve existing files and directories directly (/ → index.html via DirectoryIndex).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Missing static assets should 404, not return the SPA's HTML with 200.
  RewriteRule ^assets/ - [R=404,L]
  RewriteRule \.(png|jpe?g|gif|webp|svg|ico|js|mjs|css|map|txt|xml|json|webmanifest|woff2?)$ - [R=404,L]

  # Known app routes (keep in sync with frontend/src/app/app.routes.ts).
  RewriteRule ^(home|listings|inventory|gst-calculator|admin|settings|privacy|terms|refund-policy|contact|login|signup|register|reset-password|forgot-password|verify-email)/?$ index.html [L]
  RewriteRule ^optimize(/.*)?$ index.html [L]
  RewriteRule ^workspace/.+$ index.html [L]

  # Everything else is not a page: real 404 (served by ErrorDocument above).
  RewriteRule ^ - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
  # index.html must never be cached, so a new deploy is picked up immediately.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Hashed bundles (main-ABC123.js, chunk-XYZ.js, styles-….css) never change: cache for a year.
  <FilesMatch "-[A-Z0-9]{8,}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # ---- Security headers ----
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Camera stays allowed for this site only (barcode scanner).
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=()"

  # Content-Security-Policy in REPORT-ONLY mode first: nothing is blocked, violations are only
  # logged in the browser console (DevTools → Console). After a week with no unexpected
  # violations, rename the header to "Content-Security-Policy" to enforce it.
  # 'unsafe-inline' in script-src is needed for the inline gtag/GTM snippets in index.html and for
  # tags GTM injects; remove it once GTM is replaced by nonce-based loading.
  # Kept on ONE line on purpose: LiteSpeed does not reliably support "\" line continuation.
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://connect.facebook.net https://checkout.razorpay.com https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://m.media-amazon.com https://*.media-amazon.com https://*.ssl-images-amazon.com https://img.fkcdn.com https://*.fkcdn.com https://*.flixcart.com https://images.meesho.com https://cdn.sellassist.in https://api.sellassist.in https://upload.wikimedia.org https://api.dicebear.com https://www.transparenttextures.com https://www.googletagmanager.com https://*.google-analytics.com https://www.facebook.com https://*.razorpay.com https://lh3.googleusercontent.com; connect-src 'self' https://api.sellassist.in https://cdn.sellassist.in https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://connect.facebook.net https://www.facebook.com https://*.razorpay.com https://accounts.google.com/gsi/; frame-src https://*.razorpay.com https://accounts.google.com https://www.googletagmanager.com https://www.facebook.com; worker-src 'self' blob:; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://*.razorpay.com; frame-ancestors 'self'"
</IfModule>
