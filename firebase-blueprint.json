{
  "entities": {
    "users": {
      "title": "User",
      "description": "Seller profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique identifier for the user" },
        "email": { "type": "string", "format": "email", "description": "User's email address" },
        "displayName": { "type": "string", "description": "User's display name" },
        "photoURL": { "type": "string", "description": "URL to user's profile picture" }
      },
      "required": ["uid", "email"]
    },
    "listings": {
      "title": "Product Listing",
      "description": "Generated and optimized product listing",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Owner's user ID" },
        "name": { "type": "string", "description": "Product name" },
        "description": { "type": "string", "description": "Product description" },
        "priceINR": { "type": "string", "description": "Price in INR" },
        "gstRate": { "type": "string", "description": "GST rate" },
        "hsnCode": { "type": "string", "description": "HSN code" },
        "material": { "type": "string", "description": "Material" },
        "variations": { "type": "array", "items": { "type": "string" } },
        "platformContent": { "type": "object" },
        "originalImage": { "type": "string", "description": "Base64 or URL of original image" },
        "processedImage": { "type": "string", "description": "Base64 or URL of processed image" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "createdAt"]
    },
    "templates": {
      "title": "User Templates",
      "description": "Custom templates for different platforms",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "configs": {
          "type": "array",
          "items": { "type": "object" }
        }
      },
      "required": ["uid", "configs"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "User profile documents"
    },
    "/listings/{listingId}": {
      "schema": "listings",
      "description": "Optimized product listings"
    },
    "/templates/{userId}": {
      "schema": "templates",
      "description": "User platform templates"
    }
  }
}
