{
  "entities": {
    "users": {
      "title": "User",
      "description": "Seller profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique identifier for the user" },
        "email": { "type": "string", "format": "email", "description": "User's email address" },
        "displayName": { "type": "string", "description": "User's display name" },
        "photoURL": { "type": "string", "description": "URL to user's profile picture" },
        "role": { "type": "string", "enum": ["FREE", "PAID_PRO", "ADMIN"], "description": "User's subscription tier" },
        "usageCount": { "type": "number", "description": "Total number of responses/listings generated" },
        "dailyStats": {
          "type": "object",
          "properties": {
            "date": { "type": "string" },
            "count": { "type": "number" }
          }
        }
      },
      "required": ["uid", "email"]
    },
    "listings": {
      "title": "Product Listing",
      "description": "Generated and optimized product listing",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Owner's user ID" },
        "name": { "type": "string", "description": "Product name" },
        "description": { "type": "string", "description": "Product description" },
        "priceINR": { "type": "string", "description": "Display Price in INR" },
        "sellingPrice": { "type": "number", "description": "Numeric selling price" },
        "costPrice": { "type": "number", "description": "Purchase cost per unit" },
        "gstRate": { "type": "string", "description": "GST rate" },
        "hsnCode": { "type": "string", "description": "HSN code" },
        "material": { "type": "string", "description": "Material" },
        "variations": { "type": "array", "items": { "type": "string" } },
        "platformContent": { "type": "object" },
        "originalImage": { "type": "string", "description": "Base64 or URL of original image" },
        "processedImage": { "type": "string", "description": "Base64 or URL of processed image" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "createdAt"]
    },
    "sales": {
      "title": "Product Sale",
      "description": "Record of a product sale",
      "type": "object",
      "properties": {
        "listingId": { "type": "string" },
        "uid": { "type": "string" },
        "platform": { "type": "string", "enum": ["Amazon", "Flipkart", "Meesho", "Instagram", "Offline", "Other"] },
        "quantity": { "type": "number" },
        "salePrice": { "type": "number" },
        "date": { "type": "string", "format": "date-time" }
      },
      "required": ["listingId", "uid", "platform", "quantity", "salePrice", "date"]
    },
    "templates": {
      "title": "User Templates",
      "description": "Custom templates for different platforms",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "configs": {
          "type": "array",
          "items": { "type": "object" }
        }
      },
      "required": ["uid", "configs"]
    },
    "verificationCodes": {
      "title": "Verification Codes",
      "description": "Temporary OTP codes for email verification",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "code": { "type": "string" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "code", "expiresAt"]
    },
    "feedback": {
      "title": "User Feedback",
      "description": "Ratings and reviews for generated listings",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "User ID of the reviewer" },
        "listingId": { "type": "string", "description": "ID of the listing being rated" },
        "rating": { "type": "number", "description": "Rating from 1-5" },
        "comment": { "type": "string", "description": "Optional text feedback" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "listingId", "rating", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "User profile documents"
    },
    "/listings/{listingId}": {
      "schema": "listings",
      "description": "Optimized product listings"
    },
    "/listings/{listingId}/sales/{saleId}": {
      "schema": "sales",
      "description": "Sales history for a product"
    },
    "/templates/{userId}": {
      "schema": "templates",
      "description": "User platform templates"
    },
    "/verificationCodes/{email}": {
      "schema": "verificationCodes",
      "description": "Temporary OTP codes"
    },
    "/feedback/{feedbackId}": {
      "schema": "feedback",
      "description": "User ratings and feedback"
    }
  }
}
