rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Global Safety Net & Catch-All
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Primitive Helpers (ABAC / Zero-Trust)
    // ===============================================================
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // Auth token verification
    // function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    // NOTE: For demo simplicity and potential social providers that don't always verify, 
    // we lean on general isSignedIn(). If production readiness required, we'd add isVerified().

    // ===============================================================
    // Entity Validations
    // ===============================================================
    
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) && 
             data.keys().size() >= 2 &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() > 3;
    }

    function isValidListing(data) {
      return data.keys().hasAll(['uid', 'name', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() < 500 &&
             data.createdAt is string &&
             ( !('priceINR' in data) || data.priceINR is string ) &&
             ( !('description' in data) || data.description is string );
    }

    function isValidTemplate(data) {
      return data.keys().hasAll(['uid', 'configs']) &&
             data.uid == request.auth.uid &&
             data.configs is list && data.configs.size() <= 20;
    }

    // ===============================================================
    // Collection Match Blocks (Master Gate Pattern)
    // ===============================================================
    
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'email'])
      );
    }

    match /templates/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidTemplate(incoming());
    }

    match /listings/{listingId} {
      // Secure List Queries (Evaluation on individual documents)
      // Every 'allow list' must check auth owner to prevent scraping.
      allow read: if isSignedIn() && (
        resource.data.uid == request.auth.uid // Direct ownership check
      );
      
      allow create: if isSignedIn() && isValidListing(incoming());
      
      allow update: if isSignedIn() && 
                    existing().uid == request.auth.uid && 
                    isValidListing(incoming()) && (
                      // Action: Edit Content
                      incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'priceINR', 'gstRate', 'hsnCode', 'material', 'variations', 'platformContent', 'processedImage'])
                    );
      
      allow delete: if isSignedIn() && existing().uid == request.auth.uid;
    }
  }
}
