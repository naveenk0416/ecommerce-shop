rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Global Safety Net & Catch-All
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Primitive Helpers (ABAC / Zero-Trust)
    // ===============================================================
    function isSignedIn() { 
      return request.auth != null; 
    }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() { 
      return request.auth != null && (
        request.auth.token.email == 'naveenkumar0416@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      ); 
    }
    function isValidId(id) { return id is string && id.size() <= 128; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // ===============================================================
    // Entity Validations
    // ===============================================================
    
    function isValidUser(data) {
      return (data.uid == request.auth.uid || isAdmin()) &&
             (data.role in ['FREE', 'PAID_PRO', 'ADMIN']);
    }

    function isValidListing(data) {
      return data.keys().hasAll(['uid', 'name', 'createdAt']) &&
             (data.uid == request.auth.uid || isAdmin()) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 500 &&
             data.createdAt is string &&
             ( !('priceINR' in data) || data.priceINR is string ) &&
             ( !('description' in data) || data.description is string );
    }

    function isValidTemplate(data) {
      return data.keys().hasAll(['uid', 'configs']) &&
             (data.uid == request.auth.uid || isAdmin()) &&
             data.configs is list && data.configs.size() <= 20;
    }

    // ===============================================================
    // Collection Match Blocks (Master Gate Pattern)
    // ===============================================================
    
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) || isAdmin()) && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'email', 'lastLogin', 'phoneNumber', 'gstNumber', 'role', 'usageCount', 'dailyStats', 'uid'])
      );
    }

    match /templates/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if (isOwner(userId) || isAdmin()) && isValidTemplate(incoming());
    }

    match /listings/{listingId} {
      // Secure List Queries
      allow read: if isSignedIn() && (
        resource.data.uid == request.auth.uid || isAdmin()
      );
      
      allow create: if isSignedIn() && isValidListing(incoming());
      
      allow update: if isSignedIn() && 
                    (existing().uid == request.auth.uid || isAdmin()) && 
                    isValidListing(incoming()) && (
                      // Action: Edit Content
                      incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'priceINR', 'gstRate', 'hsnCode', 'material', 'variations', 'platformContent', 'processedImage', 'uid'])
                    );
      
      allow delete: if isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false; // Only manageable via Firebase Console for security
    }

    match /verificationCodes/{email} {
      allow get: if true;
      allow create, update: if incoming().keys().hasAll(['email', 'code', 'expiresAt']) &&
                             incoming().email == email &&
                             incoming().code is string && 
                             incoming().code.size() == 6;
      allow list, delete: if false;
    }
  }
}
