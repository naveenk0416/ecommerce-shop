rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Global Safety Net & Catch-All
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Primitive Helpers (ABAC / Zero-Trust)
    // ===============================================================
    function isSignedIn() { 
      return request.auth != null; 
    }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() { 
      return request.auth != null && (
        request.auth.token.email == 'naveenkumar0416@gmail.com' ||
        request.auth.token.email == 'naveen@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      ); 
    }
    function isValidId(id) { return id is string && id.size() <= 128; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // ===============================================================
    // Entity Validations
    // ===============================================================
    
    function isValidUser(data) {
      return (data.uid == request.auth.uid || isAdmin()) &&
             (data.role in ['FREE', 'PAID_PRO', 'ADMIN']);
    }

    function isValidListing(data) {
      return data.keys().hasAll(['uid', 'name', 'createdAt']) &&
             (data.uid == request.auth.uid || isAdmin()) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 500 &&
             data.createdAt is string &&
             ( !('priceINR' in data) || data.priceINR is string ) &&
             ( !('sellingPrice' in data) || (data.sellingPrice is number && data.sellingPrice >= 0) ) &&
             ( !('costPrice' in data) || (data.costPrice is number && data.costPrice >= 0) ) &&
             ( !('description' in data) || data.description is string ) &&
             ( !('quantity' in data) || (data.quantity is number && data.quantity >= 0) ) &&
             ( !('category' in data) || data.category is string ) &&
             ( !('gstRate' in data) || data.gstRate is string ) &&
             ( !('hsnCode' in data) || data.hsnCode is string ) &&
             ( !('material' in data) || data.material is string ) &&
             ( !('originalImage' in data) || data.originalImage is string ) &&
             ( !('processedImage' in data) || (data.processedImage is string || data.processedImage == null) ) &&
             ( !('variations' in data) || data.variations is list ) &&
             ( !('platformContent' in data) || data.platformContent is map );
    }

    function isValidSale(data) {
      return data.keys().hasAll(['uid', 'listingId', 'platform', 'quantity', 'salePrice', 'date']) &&
             (data.uid == request.auth.uid || isAdmin()) &&
             data.platform in ['Amazon', 'Flipkart', 'Meesho', 'Instagram', 'Offline', 'Other'] &&
             data.quantity is number && data.quantity > 0 &&
             data.salePrice is number && data.salePrice >= 0;
    }

    function isValidTemplate(data) {
      return data.keys().hasAll(['uid', 'configs']) &&
             (data.uid == request.auth.uid || isAdmin()) &&
             data.configs is list && data.configs.size() <= 20;
    }

    function isValidFeedback(data) {
      return data.keys().hasAll(['uid', 'listingId', 'rating', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.rating >= 1 && data.rating <= 5 &&
             ( !('comment' in data) || (data.comment is string && data.comment.size() <= 2000) );
    }

    // ===============================================================
    // Collection Match Blocks (Master Gate Pattern)
    // ===============================================================
    
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) || isAdmin()) && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'email', 'lastLogin', 'phoneNumber', 'gstNumber', 'role', 'usageCount', 'dailyStats', 'uid'])
      );
    }

    match /feedback/{feedbackId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && isValidFeedback(incoming());
      allow update, delete: if isAdmin();
    }

    match /templates/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if (isOwner(userId) || isAdmin()) && isValidTemplate(incoming());
    }

    match /listings/{listingId} {
      // Secure List Queries
      allow read: if isSignedIn() && (
        resource.data.uid == request.auth.uid || isAdmin()
      );
      
      allow create: if isSignedIn() && isValidListing(incoming());
      
      allow update: if isSignedIn() && 
                    (existing().uid == request.auth.uid || isAdmin()) && 
                    // Verify ownership remains or update is by admin
                    (incoming().uid == existing().uid || isAdmin()) && (
                      // Action: Edit Content or Sync Inventory
                      incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'priceINR', 'sellingPrice', 'costPrice', 'gstRate', 'hsnCode', 'material', 'variations', 'platformContent', 'processedImage', 'originalImage', 'uid', 'quantity', 'category', 'id'])
                    );
      
      allow delete: if isSignedIn() && (existing().uid == request.auth.uid || isAdmin());

      // Sales Subcollection
      match /sales/{saleId} {
        allow read: if isSignedIn() && (get(/databases/$(database)/documents/listings/$(listingId)).data.uid == request.auth.uid || isAdmin());
        allow create: if isSignedIn() && isValidSale(incoming()) && 
                      (get(/databases/$(database)/documents/listings/$(listingId)).data.uid == request.auth.uid || isAdmin());
        allow delete: if isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/listings/$(listingId)).data.uid == request.auth.uid);
      }
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false; // Only manageable via Firebase Console for security
    }

    match /verificationCodes/{email} {
      allow get: if true;
      allow create, update: if incoming().keys().hasAll(['email', 'code', 'expiresAt']) &&
                             incoming().email == email &&
                             incoming().code is string && 
                             incoming().code.size() == 6;
      allow list, delete: if false;
    }
  }
}
